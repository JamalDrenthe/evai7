# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database (Supabase Postgres) ────────────────────────────────
# Use the Supabase Transaction Pooler connection string (port 6543).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=             # Supabase Postgres connection string (postgresql://...)

# ── LLM Orchestrator (NEW) ──────────────────────────────────────
# Provider: "openai" (compatible: OpenAI/Groq/Together/OpenRouter), "ollama" (local), or empty for mock
LLM_PROVIDER=             # openai | ollama | <empty>
LLM_API_KEY=              # API key for OpenAI-compatible provider
LLM_MODEL=                # Model name (e.g. gpt-4o-mini, llama3.2, qwen2.5:14b)
LLM_BASE_URL=             # Optional override (e.g. https://api.groq.com/openai/v1)
OLLAMA_HOST=              # Optional, default http://localhost:11434/v1

# ── Memory (NEW) ────────────────────────────────────────────────
# Optional. Without REDIS_URL the orchestrator uses an in-process LRU map.
REDIS_URL=                # redis://localhost:6379
SESSION_TTL_HOURS=6

# ── Python Sidecar (Phase 4, optional) ──────────────────────────
PYTHON_BRIDGE_URL=        # http://localhost:8001 — for Voice Verification etc.

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Supabase (frontend client for Documents + Organogram CRUD) ──
# When empty, the frontend falls back to localStorage (offline mode).
VITE_SUPABASE_URL=        # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=   # Supabase anon (publishable) key

# ── Backend (Auth, legacy Kimi OAuth — currently unused) ────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── GitHub ──────────────────────────────────────────────────────
# Personal Access Token (classic) for backend GitHub API calls.
# Generate at https://github.com/settings/tokens (scopes: repo, read:user).
GITHUB_TOKEN=             # ghp_...

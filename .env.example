# ═══════════════════════════════════════════════════════════════════
#  EVAI Ecosystem Platform — environment template
# ═══════════════════════════════════════════════════════════════════
#  Copy to .env and fill in. Only APP_ID + APP_SECRET are required to
#  boot the app in demo mode; everything else degrades gracefully:
#    • no DATABASE_URL   → DB-backed routers disabled
#    • no LLM_PROVIDER   → mock LLM with demo tool-calling
#    • no REDIS_URL      → in-process LRU session store
#    • no VITE_SUPABASE_* → Documents/Organogram use localStorage
#
#  See README → "Environment variables" for the full reference.
# ═══════════════════════════════════════════════════════════════════


# ── Backend core (required) ─────────────────────────────────────
#  Generate a strong APP_SECRET for production with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_ID=                   # Application ID, used as JWT issuer
APP_SECRET=               # JWT signing secret — long random string


# ── Database — Supabase Postgres (optional) ─────────────────────
#  Supabase → Project Settings → Database → "Transaction Pooler" (port 6543).
#  Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#  Required for: drizzle-kit commands and DB-backed tRPC routers.
DATABASE_URL=


# ── LLM Orchestrator ────────────────────────────────────────────
#  Provider options:
#    openai  → OpenAI, Groq, Together, OpenRouter, Gemini (OpenAI-compatible)
#    ollama  → local Ollama server
#    <empty> → mock client (demos tool-calling without any key)
LLM_PROVIDER=             # openai | ollama | <empty>
LLM_API_KEY=              # sk-... | gsk_... | AIza... | ghs_... | etc.
LLM_MODEL=                # e.g. gpt-4o-mini, gemini-2.5-flash, llama-3.3-70b-versatile
LLM_BASE_URL=             # optional override — e.g. https://api.groq.com/openai/v1
OLLAMA_HOST=              # optional — default http://localhost:11434/v1


# ── Memory & session store (optional) ───────────────────────────
#  Without REDIS_URL the orchestrator uses an in-process LRU map (lost on restart).
REDIS_URL=                # redis://localhost:6379
SESSION_TTL_HOURS=6


# ── Python Sidecar (optional, Voice Verification) ───────────────
#  Only required when running the python-services container.
PYTHON_BRIDGE_URL=        # http://localhost:8001


# ── Frontend (exposed to browser via Vite) ──────────────────────
#  Anything prefixed VITE_ is shipped to the client bundle.
#  NEVER put server-side secrets here.
VITE_APP_ID=              # usually mirrors APP_ID
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (client-side, currently unused)


# ── Supabase — frontend client (Documents + Organogram CRUD) ────
#  When BOTH are empty, the frontend falls back to localStorage mode.
VITE_SUPABASE_URL=        # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=   # Supabase anon (publishable) key


# ── Legacy Kimi OAuth (currently unused) ────────────────────────
#  Reserved for when real Kimi OAuth replaces the demo login.
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)


# ── Admin role (optional) ───────────────────────────────────────
#  Union ID of the app creator. This user receives role="admin" on first sign-in.
OWNER_UNION_ID=


# ── GitHub (optional, backend API calls) ────────────────────────
#  Personal Access Token (classic). Generate at:
#    https://github.com/settings/tokens
#  Pick the scopes required by whichever backend features you use.
GITHUB_TOKEN=             # ghp_...
